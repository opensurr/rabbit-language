print(("Hello"):len(), ("Hello"):upper(), string.sub("abcdef", 2, 4), string.sub("abcdef", -2))
print(string.find("banana", "an"), string.find("banana", "an", 2), string.find("a.b", ".", 0, true))
print(string.match("2026-11-11", "(%d+)-(%d+)-(%d+)"))
print(string.gsub("hello world", "(%w+)", "<%1>"))
print(string.gsub("$name is $age", "%$(%w+)", {name = "Bunny", age = 16}))
print(string.gsub("f(a(b)c)", "%b()", "X"))
for word in string.gmatch("one two three", "%a+") { print(word) }
print(string.format("%05.1f|%4d|%-4s|%x", 3.14159, 42, "ok", 255))
print(string.lpad("7", 3, "0"), string.rpad("ab", 4, "."), string.trim("  hi  "))
print(string.split("a,b,c", ","), string.replace("a-b-c", "-", "+"))
