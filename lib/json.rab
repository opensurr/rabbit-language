
let json = {}

let esc = func(s) {
  s = string.replace(s, "\\", "\\\\")
  s = string.replace(s, "\"", "\\\"")
  s = string.replace(s, "\n", "\\n")
  s = string.replace(s, "\r", "\\r")
  s = string.replace(s, "\t", "\\t")
  return s
}

json.encode = func(v) {
  let t = type(v)
  if (t == "nil") {
    return "null"
  } elseif (t == "boolean" or t == "number") {
    return tostring(v)
  } elseif (t == "string") {
    return "\"" .. esc(v) .. "\""
  } elseif (t == "array") {
    let parts = []
    for item in v {
      parts:push(json.encode(item))
    }
    return "[" .. table.concat(parts, ",") .. "]"
  } elseif (t == "table") {
    let parts = []
    for k, item in v {
      parts:push(json.encode(tostring(k)) .. ":" .. json.encode(item))
    }
    return "{" .. table.concat(parts, ",") .. "}"
  }
  error("json cannot encode a " .. t)
}

json.decode = func(text) {
  let i = 0
  let n = #text
  let parse_value = nil

  let skip = func() {
    while (i < n and string.find(" \t\r\n", string.sub(text, i, i + 1), 0, true) ~= nil) {
      i += 1
    }
  }

  let parse_string = func() {
    i += 1
    let out = []
    while (i < n) {
      let c = string.sub(text, i, i + 1)
      if (c == "\"") {
        i += 1
        return table.concat(out, "")
      }
      if (c == "\\") {
        let e = string.sub(text, i + 1, i + 2)
        if (e == "n") {
          out:push("\n")
        } elseif (e == "t") {
          out:push("\t")
        } elseif (e == "r") {
          out:push("\r")
        } else {
          out:push(e)
        }
        i += 2
      } else {
        out:push(c)
        i += 1
      }
    }
    error("JSON text ends inside a string")
  }

  let parse_number = func() {
    let start = i
    while (i < n and string.find("-+.eE0123456789", string.sub(text, i, i + 1), 0, true) ~= nil) {
      i += 1
    }
    let value = tonumber(string.sub(text, start, i))
    if (value == nil) {
      error("bad number in JSON at position " .. start)
    }
    return value
  }

  parse_value = func() {
    skip()
    let c = string.sub(text, i, i + 1)
    if (c == "\"") {
      return parse_string()
    } elseif (c == "{") {
      i += 1
      let obj = {}
      skip()
      if (string.sub(text, i, i + 1) == "}") {
        i += 1
        return obj
      }
      while (true) {
        skip()
        let key = parse_string()
        skip()
        i += 1
        obj[key] = parse_value()
        skip()
        let sep = string.sub(text, i, i + 1)
        i += 1
        if (sep == "}") {
          break
        }
        if (sep ~= ",") {
          error("expected ',' or '}' in JSON object")
        }
      }
      return obj
    } elseif (c == "[") {
      i += 1
      let arr = []
      skip()
      if (string.sub(text, i, i + 1) == "]") {
        i += 1
        return arr
      }
      while (true) {
        arr:push(parse_value())
        skip()
        let sep = string.sub(text, i, i + 1)
        i += 1
        if (sep == "]") {
          break
        }
        if (sep ~= ",") {
          error("expected ',' or ']' in JSON array")
        }
      }
      return arr
    } elseif (string.sub(text, i, i + 4) == "true") {
      i += 4
      return true
    } elseif (string.sub(text, i, i + 5) == "false") {
      i += 5
      return false
    } elseif (string.sub(text, i, i + 4) == "null") {
      i += 4
      return nil
    }
    return parse_number()
  }

  return parse_value()
}

return json
